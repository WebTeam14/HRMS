# Server Environment Variables
# Copy these values into Render environment variables panel
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hrms?retryWrites=true&w=majority
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
CLIENT_URL=https://your-hrms-frontend.vercel.app
